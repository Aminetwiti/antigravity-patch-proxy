{
  "name": "ag-remote-ui",
  "version": "1.0.0",
  "description": "Antigravity Remote Daemon Manager — Dedicated 1-Page Electron App",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/copy-assets.js && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/strip-module-syntax.js",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "keywords": [
    "antigravity",
    "remote",
    "daemon",
    "mobile",
    "electron"
  ],
  "author": "Antigravity",
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "dev.antigravity.remote-ui",
    "productName": "Antigravity Remote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ag-remote-${version}-portable.${ext}"
    }
  }
}
